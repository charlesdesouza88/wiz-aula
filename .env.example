# Copy to .env.local for local development. Never commit real values.

# Supabase project (Project Settings › API): the URL and the publishable (anon) key.
# Both are public by design; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The project must allow anonymous sign-ins (Authentication › Sign In / Providers):
# each device signs in anonymously, then the access code links it to a person.
