# Copy to .env.local for local development. Never commit real values.

# Supabase project (Project Settings › API). Local defaults come from `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: bypasses row-level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server only: secret key for hashing access codes (HMAC-SHA256).
# supabase/seed.sql uses this dev value; use a long random value in production.
ACCESS_CODE_PEPPER=wiz-aula-dev-pepper
